<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Revolution Rise Media — Growth Systems for Businesses Ready to Scale</title>
<meta name="description" content="Revolution Rise Media builds the marketing, acquisition and consulting systems that turn attention into pipeline, and pipeline into a business that runs itself.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23050505%22/><rect x=%2232%22 y=%2222%22 width=%2214%22 height=%2256%22 fill=%22%23f2f2f0%22/><rect x=%2250%22 y=%2222%22 width=%2214%22 height=%2256%22 fill=%22%23b7bac0%22/><rect x=%2268%22 y=%2222%22 width=%2214%22 height=%2256%22 fill=%22%237c7f85%22/></svg>">

<style>
  :root{
    --black:#050505;
    --panel:#0c0c0d;
    --panel-2:#111113;
    --white:#f7f7f5;
    --pure-white:#ffffff;
    --silver-100:#e7e8ea;
    --silver-300:#bcbfc5;
    --silver-500:#8a8d93;
    --silver-700:#525459;
    --line:rgba(247,247,245,0.14);
    --line-soft:rgba(247,247,245,0.08);
    --serif:'Newsreader', Georgia, serif;
    --sans:'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    --maxw:1180px;
    --ease:cubic-bezier(.16,.8,.24,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  body{
    background:var(--black);
    color:var(--white);
    font-family:var(--sans);
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;}

  ::selection{background:var(--silver-300);color:var(--black);}

  .wrap{
    max-width:var(--maxw);
    margin:0 auto;
    padding:0 32px;
  }

  :focus-visible{
    outline:1.5px solid var(--silver-300);
    outline-offset:3px;
  }

  h1,h2,h3,h4{
    font-family:var(--serif);
    font-weight:500;
    line-height:1.08;
    letter-spacing:-0.01em;
  }

  .eyebrow-label{
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
    color:var(--silver-500);
    letter-spacing:0.02em;
  }

  .section{
    padding:132px 0;
    border-top:1px solid var(--line-soft);
    position:relative;
  }
  @media(max-width:768px){
    .section{padding:84px 0;}
  }

  .section-head{
    max-width:640px;
    margin-bottom:64px;
  }
  .section-head h2{
    font-size:clamp(30px,4vw,46px);
    margin-top:14px;
  }
  .section-head p{
    font-size:17px;
    color:var(--silver-300);
    margin-top:18px;
    max-width:52ch;
  }

  /* ---------- reveal ---------- */
  .reveal{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .8s var(--ease), transform .8s var(--ease);
  }
  .reveal.is-visible{
    opacity:1;
    transform:translateY(0);
  }

  /* ---------- buttons ---------- */
  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:15px 28px;
    font-size:15px;
    font-weight:600;
    border-radius:2px;
    transition:background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease);
    white-space:nowrap;
  }
  .btn-primary{
    background:var(--white);
    color:var(--black);
    border:1px solid var(--white);
  }
  .btn-primary:hover{
    background:transparent;
    color:var(--white);
    border-color:var(--silver-300);
  }
  .btn-ghost{
    border:1px solid var(--line);
    color:var(--white);
  }
  .btn-ghost:hover{
    border-color:var(--silver-300);
    background:var(--panel-2);
  }
  .link-underline{
    position:relative;
    font-weight:600;
    font-size:15px;
    padding-bottom:2px;
    background-image:linear-gradient(var(--silver-300),var(--silver-300));
    background-position:0 100%;
    background-repeat:no-repeat;
    background-size:0% 1px;
    transition:background-size .4s var(--ease);
  }
  .link-underline:hover{background-size:100% 1px;}

  /* ---------- nav ---------- */
  header{
    position:fixed;
    top:0;left:0;right:0;
    z-index:100;
    padding:22px 0;
    transition:padding .4s var(--ease), background .4s var(--ease), border-color .4s var(--ease);
    border-bottom:1px solid transparent;
  }
  header.scrolled{
    padding:14px 0;
    background:rgba(5,5,5,0.86);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line-soft);
  }
  header .wrap{
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .logo-mark{height:26px;width:auto;}
  nav.primary-nav{
    display:flex;
    align-items:center;
    gap:38px;
  }
  nav.primary-nav a{
    font-size:14px;
    font-weight:600;
    color:var(--silver-300);
    transition:color .3s;
  }
  nav.primary-nav a:hover{color:var(--white);}
  .nav-right{display:flex;align-items:center;gap:26px;}
  .menu-toggle{
    display:none;
    flex-direction:column;
    gap:5px;
    padding:6px;
  }
  .menu-toggle span{
    width:22px;height:1.5px;background:var(--white);
    transition:transform .3s, opacity .3s;
  }

  @media(max-width:900px){
    nav.primary-nav{
      position:fixed;
      inset:0;
      top:64px;
      background:var(--black);
      flex-direction:column;
      align-items:flex-start;
      padding:40px 32px;
      gap:26px;
      transform:translateX(100%);
      transition:transform .45s var(--ease);
      border-top:1px solid var(--line-soft);
    }
    nav.primary-nav.open{transform:translateX(0);}
    nav.primary-nav a{font-size:22px;font-family:var(--serif);color:var(--white);}
    .nav-right .btn-primary{display:none;}
    nav.primary-nav .mobile-cta{display:inline-flex;margin-top:12px;}
    .menu-toggle{display:flex;}
  }
  @media(min-width:901px){
    nav.primary-nav .mobile-cta{display:none;}
  }

  /* ---------- hero ---------- */
  .hero{
    padding:196px 0 120px;
    position:relative;
  }
  .hero-grid-lines{
    position:absolute;
    inset:0;
    pointer-events:none;
    background-image:
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size:calc((100% - 64px)/3) 100%;
    background-position:32px 0;
    mask-image:linear-gradient(to bottom, black, transparent 85%);
    opacity:.5;
  }
  .hero-inner{max-width:820px;}
  .hero h1{
    font-size:clamp(38px,6vw,74px);
    overflow:hidden;
  }
  .hero h1 .line{
    display:block;
    overflow:hidden;
  }
  .hero h1 .line span{
    display:block;
    transform:translateY(110%);
    animation:lineUp .9s var(--ease) forwards;
  }
  .hero h1 .line:nth-child(1) span{animation-delay:.05s;}
  .hero h1 .line:nth-child(2) span{animation-delay:.18s;}
  .hero h1 .line:nth-child(3) span{animation-delay:.31s;}
  @keyframes lineUp{to{transform:translateY(0);}}

  .hero p.sub{
    margin-top:28px;
    font-size:19px;
    color:var(--silver-300);
    max-width:52ch;
    opacity:0;
    animation:fadeUp .9s var(--ease) forwards;
    animation-delay:.55s;
  }
  .hero .cta-row{
    margin-top:40px;
    display:flex;
    align-items:center;
    gap:28px;
    flex-wrap:wrap;
    opacity:0;
    animation:fadeUp .9s var(--ease) forwards;
    animation-delay:.7s;
  }
  .hero .proof-line{
    margin-top:64px;
    padding-top:24px;
    border-top:1px solid var(--line-soft);
    font-size:14px;
    color:var(--silver-500);
    max-width:52ch;
    opacity:0;
    animation:fadeUp .9s var(--ease) forwards;
    animation-delay:.85s;
  }
  @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- problem / flow ---------- */
  .flow-strip{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:1px;
    background:var(--line-soft);
    border:1px solid var(--line-soft);
    margin-top:8px;
  }
  .flow-step{
    background:var(--black);
    padding:34px 26px 30px;
    position:relative;
  }
  .flow-step .num{
    font-family:var(--serif);
    font-size:14px;
    color:var(--silver-700);
  }
  .flow-step h4{
    font-family:var(--sans);
    font-size:16px;
    font-weight:700;
    margin-top:14px;
    color:var(--silver-500);
  }
  .flow-step p{
    font-size:14px;
    color:var(--silver-700);
    margin-top:8px;
    line-height:1.55;
  }
  .flow-step.is-active{background:var(--panel);}
  .flow-step.is-active h4{color:var(--white);}
  .flow-step.is-active p{color:var(--silver-300);}
  .flow-step.is-active::before{
    content:'';
    position:absolute;
    top:0;left:0;right:0;
    height:2px;
    background:linear-gradient(90deg,var(--silver-100),var(--silver-700));
  }
  @media(max-width:760px){
    .flow-strip{grid-template-columns:1fr;}
  }

  /* ---------- services ---------- */
  .services-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1px;
    background:var(--line-soft);
    border:1px solid var(--line-soft);
  }
  .service-card{
    background:var(--black);
    padding:46px 38px 42px;
    display:flex;
    flex-direction:column;
    min-height:460px;
  }
  .service-card .idx{
    font-family:var(--serif);
    font-style:italic;
    font-size:15px;
    color:var(--silver-700);
  }
  .service-card h3{
    font-size:27px;
    margin-top:22px;
  }
  .service-card p.desc{
    font-size:15px;
    color:var(--silver-300);
    margin-top:16px;
    line-height:1.65;
  }
  .service-card .mini{
    margin-top:auto;
    padding-top:30px;
  }

  /* marketing mini: precision rings */
  .precision{
    width:100%;
    height:96px;
    position:relative;
  }
  .precision svg{width:100%;height:100%;}

  /* acquisition mini: chip chain */
  .chip-chain{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:8px;
    font-size:12px;
    color:var(--silver-500);
  }
  .chip-chain span.chip{
    border:1px solid var(--line);
    padding:6px 11px;
    border-radius:100px;
    white-space:nowrap;
  }
  .chip-chain span.chip:last-child{
    color:var(--white);
    border-color:var(--silver-300);
  }
  .chip-chain .sep{color:var(--silver-700);}

  /* consulting mini: stacked steps */
  .step-list{
    display:flex;
    flex-direction:column;
    gap:0;
    font-size:13px;
    color:var(--silver-500);
  }
  .step-list div{
    display:flex;
    align-items:center;
    gap:10px;
    padding:8px 0;
    border-top:1px solid var(--line-soft);
  }
  .step-list div:first-child{border-top:none;}
  .step-list .dot{
    width:5px;height:5px;border-radius:50%;
    background:var(--silver-700);
    flex-shrink:0;
  }
  .step-list div:last-child .dot{background:var(--silver-100);}
  .step-list div:last-child{color:var(--white);}

  @media(max-width:900px){
    .services-grid{grid-template-columns:1fr;}
    .service-card{min-height:0;}
  }

  /* ---------- growth system ---------- */
  .system-section{background:var(--panel);}
  .system-flow{
    margin-top:76px;
    display:flex;
    align-items:stretch;
    gap:0;
  }
  .system-node{
    flex:1;
    padding:34px 22px;
    text-align:left;
    position:relative;
  }
  .system-node h4{
    font-family:var(--serif);
    font-size:23px;
    font-weight:500;
  }
  .system-node p{
    font-size:13.5px;
    color:var(--silver-500);
    margin-top:10px;
    line-height:1.6;
  }
  .system-node .n{
    font-size:12px;
    color:var(--silver-700);
    font-weight:700;
    letter-spacing:0.04em;
  }
  .system-connector{
    width:60px;
    flex-shrink:0;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .system-connector svg{width:100%;height:20px;}
  .system-node.final h4{color:var(--white);}
  .system-node.final{
    background:linear-gradient(180deg, rgba(247,247,245,0.05), transparent);
    border:1px solid var(--line);
  }
  @media(max-width:900px){
    .system-flow{flex-direction:column;}
    .system-connector{width:100%;height:34px;}
    .system-connector svg{width:20px;height:100%;transform:rotate(0deg);}
  }

  /* ---------- case studies ---------- */
  .case-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1px;
    background:var(--line-soft);
    border:1px solid var(--line-soft);
    margin-top:8px;
  }
  .case-card{
    background:var(--black);
    display:flex;
    flex-direction:column;
  }
  .case-visual{
    aspect-ratio:16/10;
    width:100%;
    position:relative;
    overflow:hidden;
    background:
      repeating-linear-gradient(135deg, rgba(247,247,245,0.05) 0px, rgba(247,247,245,0.05) 1px, transparent 1px, transparent 13px),
      var(--panel);
  }
  .case-visual .tag{
    position:absolute;
    left:20px;bottom:18px;
    font-size:11.5px;
    color:var(--silver-700);
    background:rgba(5,5,5,0.7);
    padding:5px 10px;
    border:1px solid var(--line-soft);
  }
  .case-visual .mono{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:.5;
  }
  .case-visual .mono svg{width:34px;height:34px;}
  .case-visual img{
    width:100%;height:100%;
    object-fit:cover;
    display:block;
    filter:grayscale(0.15) contrast(1.03);
  }
  .case-body{
    padding:32px 34px 38px;
  }
  .case-body .industry{
    font-size:13px;
    color:var(--silver-700);
    font-weight:600;
  }
  .case-body h3{
    font-size:23px;
    margin-top:10px;
  }
  .case-body .result{
    margin-top:18px;
    font-family:var(--serif);
    font-size:20px;
    color:var(--silver-100);
    border-left:2px solid var(--silver-500);
    padding-left:16px;
  }
  .case-body p.note{
    margin-top:16px;
    font-size:14px;
    color:var(--silver-500);
    line-height:1.6;
  }
  @media(max-width:760px){
    .case-grid{grid-template-columns:1fr;}
  }

  /* ---------- about ---------- */
  .about-grid{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:70px;
    align-items:center;
  }
  .about-visual{
    aspect-ratio:4/5;
    width:100%;
    background:
      repeating-linear-gradient(135deg, rgba(247,247,245,0.05) 0px, rgba(247,247,245,0.05) 1px, transparent 1px, transparent 13px),
      var(--panel);
    border:1px solid var(--line-soft);
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
  }
  .about-visual span.tag{
    position:absolute;
    left:18px;bottom:18px;
    font-size:11.5px;
    color:var(--silver-300);
    background:rgba(5,5,5,0.7);
    padding:5px 10px;
    border:1px solid var(--line-soft);
    z-index:2;
  }
  .about-visual img{
    width:100%;height:100%;
    object-fit:cover;
    display:block;
    filter:grayscale(0.15) contrast(1.03);
  }
  .about-copy .eyebrow-label{margin-bottom:14px;display:block;}
  .about-copy h2{
    font-size:clamp(28px,3.6vw,40px);
  }
  .about-copy p{
    margin-top:20px;
    font-size:16.5px;
    color:var(--silver-300);
    line-height:1.75;
    max-width:54ch;
  }
  .about-copy .signoff{
    margin-top:30px;
    font-family:var(--serif);
    font-style:italic;
    font-size:17px;
    color:var(--silver-100);
  }
  @media(max-width:860px){
    .about-grid{grid-template-columns:1fr;gap:40px;}
  }

  /* ---------- testimonials ---------- */
  .testi-rail{
    margin-top:8px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:1px;
    background:var(--line-soft);
    border:1px solid var(--line-soft);
  }
  .testi-card{
    background:var(--black);
    padding:38px 36px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    min-height:250px;
  }
  .testi-card blockquote{
    font-family:var(--serif);
    font-size:19px;
    line-height:1.5;
    color:var(--white);
  }
  .testi-card .attr{
    margin-top:24px;
    font-size:13.5px;
    color:var(--silver-500);
  }
  .testi-card .attr strong{
    color:var(--silver-300);
    font-weight:700;
    display:block;
    font-size:14px;
    margin-bottom:2px;
  }
  @media(max-width:760px){
    .testi-rail{grid-template-columns:1fr;}
  }

  /* ---------- faq ---------- */
  .faq-list{
    margin-top:8px;
    border-top:1px solid var(--line-soft);
    max-width:760px;
  }
  .faq-item{
    border-bottom:1px solid var(--line-soft);
  }
  .faq-q{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
    padding:26px 0;
    text-align:left;
    font-size:17px;
    font-weight:600;
  }
  .faq-q .plus{
    flex-shrink:0;
    width:18px;height:18px;
    position:relative;
  }
  .faq-q .plus::before,.faq-q .plus::after{
    content:'';
    position:absolute;
    background:var(--silver-300);
    transition:transform .35s var(--ease);
  }
  .faq-q .plus::before{left:0;top:50%;width:100%;height:1px;transform:translateY(-50%);}
  .faq-q .plus::after{top:0;left:50%;height:100%;width:1px;transform:translateX(-50%);}
  .faq-item.open .faq-q .plus::after{transform:translateX(-50%) rotate(90deg);opacity:0;}
  .faq-a{
    max-height:0;
    overflow:hidden;
    transition:max-height .45s var(--ease);
  }
  .faq-a p{
    padding:0 0 26px;
    font-size:15px;
    color:var(--silver-300);
    max-width:60ch;
    line-height:1.7;
  }

  /* ---------- final cta ---------- */
  .final-cta{
    text-align:left;
    padding:150px 0 150px;
  }
  .final-cta h2{
    font-size:clamp(34px,5.4vw,64px);
    max-width:760px;
  }
  .final-cta p{
    margin-top:22px;
    font-size:18px;
    color:var(--silver-300);
    max-width:52ch;
  }
  .final-cta .cta-row{
    margin-top:42px;
    display:flex;
    align-items:center;
    gap:30px;
    flex-wrap:wrap;
  }
  .final-cta .email{
    font-size:15px;
    color:var(--silver-500);
  }

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line-soft);
    padding:50px 0;
  }
  footer .wrap{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:24px;
  }
  footer .logo-mark{height:20px;opacity:.85;}
  footer nav{display:flex;gap:28px;flex-wrap:wrap;}
  footer nav a{font-size:13.5px;color:var(--silver-500);}
  footer nav a:hover{color:var(--white);}
  footer .copy{font-size:12.5px;color:var(--silver-700);}

  .visually-hidden{
    position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);
  }
</style>
</head>
<body>

<header id="siteHeader">
  <div class="wrap">
    <a href="#top" aria-label="Revolution Rise Media — home">
      <img class="logo-mark" src="data:image/png;base64," alt="Revolution Rise Media">
    </a>
    <nav class="primary-nav" id="primaryNav">
      <a href="#services">Services</a>
